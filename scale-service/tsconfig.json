{
  "compilerOptions": {
    /* Bahasa & Modul */
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",

    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,

    /* Wajib untuk TypeORM (decorator) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* Interop & strictness */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    /* Path alias */
    "baseUrl": "./src",
    "paths": {
      "@config/*": ["config/*"],
      "@entities/*": ["entities/*"],
      "@services/*": ["services/*"],
      "@controllers/*": ["controllers/*"],
      "@routes/*": ["routes/*"],
      "@middlewares/*": ["middlewares/*"],
      "@utils/*": ["utils/*"],
      "@types/*": ["types/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}